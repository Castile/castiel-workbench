{
  "name": "prototype",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test": "node --test tests/agent-data.test.mjs tests/workspace-data.test.mjs tests/local-store.test.mjs",
    "desktop:start": "electron desktop/main.mjs",
