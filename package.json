{
  "name": "castiel-workbench",
  "version": "0.3.2",
  "private": true,
  "description": "Castiel local desktop workbench — design and development baseline",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "setup": "npm ci --prefix prototype",
    "dev": "npm --prefix prototype run dev -- --host 127.0.0.1 --port 4173 --strictPort",
    "build": "npm --prefix prototype run build",
    "preview": "npm --prefix prototype run preview -- --host 127.0.0.1 --port 4174 --strictPort",
    "test": "npm --prefix prototype test",
    "test:package": "npm --prefix prototype run test:sites",
    "check": "npm run build && npm test && npm run test:package",
    "dev:desktop": "npm --prefix prototype run desktop:dev",
    "desktop:start": "npm --prefix prototype run desktop:start",
    "desktop:package": "npm --prefix prototype run desktop:package"
  }
}
